# Copy to .env (git-ignored). Never commit real keys.
SERPAPI_API_KEY=
# Offline models only. Cloud: https://ollama.com; local: http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
# Pin the revision from /api/tags; update this when changing model weights.
OLLAMA_MODEL_VERSION=gpt-oss:120b@d98fe6ba01e6
JEV_API_KEY=
JEV_MODEL_VERSION=jev-1.13.0
OPENFEC_API_KEY=
CONGRESS_GOV_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
# Optional cheap extraction fallback for official minutes (OpenAI-compatible).
# Off by default. Spans must exactly match source text or the result is rejected.
EXTRACT_LLM_BASE_URL=
EXTRACT_LLM_API_KEY=
EXTRACT_LLM_MODEL=
EXTRACT_LLM_CACHE_DIR=
DATABASE_URL=
