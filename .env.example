# Copy to .env (git-ignored). Never commit real keys.
SERPAPI_API_KEY=
# Optional: X API v2 bearer token. Without it, X falls back to SerpApi snippets.
X_BEARER_TOKEN=
GEMINI_API_KEY=
# Offline classification: TypeSafe Jev primary; Ollama Cloud fallback.
JEV_API_KEY=
OLLAMA_API_KEY=
JEV_MODEL_VERSION=jev-1.14.0
OLLAMA_MODEL=gpt-oss:20b
# Freeze the digest returned by https://ollama.com/api/tags for a release.
OLLAMA_MODEL_DIGEST=
OPENFEC_API_KEY=
CONGRESS_GOV_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
# Optional cheap extraction fallback for official minutes (OpenAI-compatible).
# Off by default. Spans must exactly match source text or the result is rejected.
EXTRACT_LLM_BASE_URL=
EXTRACT_LLM_API_KEY=
EXTRACT_LLM_MODEL=
EXTRACT_LLM_CACHE_DIR=
DATABASE_URL=
