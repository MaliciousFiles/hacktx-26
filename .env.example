# Copy to .env (git-ignored). Never commit real keys.
SERPAPI_API_KEY=
# Used automatically once the primary key reports it is out of searches.
SERPAPI_API_KEY_FALLBACK=
# Optional hard cap on live SerpAPI calls per process (cache hits are free). Unset = unlimited.
SERPAPI_MAX_REQUESTS=
# Optional: X API v2 bearer token. Without it, X falls back to SerpApi snippets.
X_BEARER_TOKEN=
GEMINI_API_KEY=
# Offline models only: TypeSafe Jev primary; Ollama fallback + generation.
JEV_API_KEY=
JEV_MODEL_VERSION=jev-1.14.0
# Cloud: https://ollama.com; local: http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
# Pin the revision from /api/tags; update this when changing model weights (batch/generation).
OLLAMA_MODEL_VERSION=gpt-oss:120b@d98fe6ba01e6
# Freeze the digest returned by https://ollama.com/api/tags for a release (live ballot runner fallback).
OLLAMA_MODEL_DIGEST=
OPENFEC_API_KEY=
CONGRESS_GOV_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
# Optional cheap extraction fallback for official minutes (OpenAI-compatible).
# Off by default. Spans must exactly match source text or the result is rejected.
EXTRACT_LLM_BASE_URL=
EXTRACT_LLM_API_KEY=
EXTRACT_LLM_MODEL=
EXTRACT_LLM_CACHE_DIR=
# Pipeline only: dedicated writer connection (not exposed to API/mobile).
DATABASE_WRITE_URL=
# API only: SELECT on app_data.releases/reveals; no research privileges.
DATABASE_READ_URL=
# File-backed API fallback when DATABASE_READ_URL is absent.
RELEASES_DIR=
