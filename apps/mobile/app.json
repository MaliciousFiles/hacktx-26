{
  "expo": {
    "name": "Wishing Well",
    "description": "Make a wish. Know your choice.",
    "slug": "fairy-tale-ballot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/wishing-well-logo.png",
    "userInterfaceStyle": "light",
    "scheme": "fairytaleballot",
    "ios": {
      "icon": "./assets/wishing-well-ios.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.milesfritzmather.fairytaleballot",
      "appleTeamId": "YG4U27L96Y",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0DFC2",
        "foregroundImage": "./assets/wishing-well-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.milesfritzmather.fairytaleballot"
    },
    "web": {
      "favicon": "./assets/wishing-well-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c54e1367-376f-4712-86fb-3175db8ade0c"
      }
    },
    "owner": "fragtag"
  }
}
