{
  "expo": {
    "name": "Fairy Tale Ballot",
    "slug": "fairy-tale-ballot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "fairytaleballot",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.milesfritzmather.fairytaleballot",
      "appleTeamId": "YG4U27L96Y",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3EDE2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.milesfritzmather.fairytaleballot"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c54e1367-376f-4712-86fb-3175db8ade0c"
      }
    },
    "owner": "fragtag"
  }
}
