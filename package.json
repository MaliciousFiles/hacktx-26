{
  "name": "fairy-tale-ballot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "mobile": "pnpm -F @ftb/mobile go",
    "mobile:tunnel": "pnpm -F @ftb/mobile go:tunnel",
    "mobile:clear": "pnpm -F @ftb/mobile go:clear",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
