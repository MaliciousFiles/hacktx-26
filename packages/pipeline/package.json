{
  "name": "@ftb/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "ballot-find": "tsx src/ballot-find.ts",
    "db": "tsx --env-file-if-exists=../../.env src/database/cli.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "records": "tsx --env-file-if-exists=../../.env src/records-cli.ts",
    "check-ai": "tsx --env-file-if-exists=../../.env src/check-ai.ts",
    "review-report": "tsx src/review-report.ts",
    "typecheck": "tsc --noEmit",
    "test:live": "tsx --env-file-if-exists=../../.env src/test-live-ai.ts"
  },
  "dependencies": {
    "@ftb/records": "workspace:*",
    "@ftb/scraping": "workspace:*",
    "@ftb/types": "workspace:*",
    "cheerio": "^1.2.0",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
